# Byte-compiled / optimized Python files
__pycache__/
*.py[cod]
*$py.class

# Python packaging / build artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/

# colcon / ament workspace artifacts (if the repo is built in-tree)
install/
log/

# Test & coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache/

# Linters / type checkers
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Docker playground (generated by docker/create_dot_env)
.env

# Claude Code: local state stays out; the shared agents, hooks and settings are tracked
.claude/*
!.claude/agents/
!.claude/hooks/
!.claude/settings.json

# Editor / IDE
.vscode/
.idea/
*.swp
*~
CLAUDE.md

# OS
.DS_Store
Thumbs.db

# Harness screenshots (scripts/agent_check.sh)
test/artifacts/

# The vendored textual stack: generated by scripts/vendor.py from the lock, which is all git keeps
ros_tui/_vendor/*
!ros_tui/_vendor/__init__.py
!ros_tui/_vendor/requirements.txt
